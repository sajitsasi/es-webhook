# Port the server listens on (default 3000)
PORT=3000

# Optional: require this secret for POST /webhook. Elastic can send it as
#   Authorization: Bearer <WEBHOOK_SECRET>
#   or header: X-Webhook-Secret: <WEBHOOK_SECRET>
#   or Basic auth password (any username)
# Leave empty to allow unauthenticated webhook calls.
WEBHOOK_SECRET=

# Optional: require this token for GET /events and GET /messages (query ?token= or Authorization: Bearer).
# Leave empty to allow unauthenticated read access.
READ_TOKEN=

# Max messages kept in memory (default 500). Oldest are dropped when full.
MAX_MESSAGES=500
